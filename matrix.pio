.program matrix

.wrap_target
    pull block          ; Get the 8-bit row mask from TX DMA
    out pins, 8 [31]    ; Drive rows GP0-GP7, then wait 31 microseconds
    
    nop [31]            ; Wait another 31 us
    nop [31]            ; Wait another 31 us (Total ~93us delay for electrical settling)

    in pins, 16         ; Read 16 sequential pins (GP8 through GP23)
    push block          ; Push the 16-bit result to the RX DMA
.wrap